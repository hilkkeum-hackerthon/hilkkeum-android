<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!-- 회원 토큰은 다른 기기로 복원되지 않도록 백업/기기 이전에서 제외한다. (DataStoreModule.TOKEN_DATASTORE_NAME) -->
    <cloud-backup>
        <exclude domain="file" path="datastore/token_storage.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/token_storage.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
